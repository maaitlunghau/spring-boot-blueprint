# Database
MYSQL_HOST=localhost
MYSQL_ROOT_PASSWORD=your-mysql-root-password
DB_USERNAME=app
DB_PASSWORD=your-app-database-password

# Redis
REDIS_HOST=localhost
REDIS_PASSWORD=your-redis-password

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=app
RABBITMQ_PASSWORD=your-rabbitmq-password

# Security
JWT_SECRET=your-256-bit-base64-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# DEFAULT_AVATAR_URL=https://res.cloudinary.com/your-cloud-name/image/upload/v1/defaults/avatar.png

# Spring profile: dev (local) or prod
SPRING_PROFILES_ACTIVE=dev